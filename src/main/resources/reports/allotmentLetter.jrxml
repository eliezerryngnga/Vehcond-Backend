					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[GOVERNMENT OF MEGHALAYA
TRANSPORT DEPARTMENT]]></text>
			</staticText>
		</band>
	</title>
	
	<pageHeader>
		<band height="30">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="270" height="20" uuid="a10d66a8-ad38-40f7-bbf0-add0b437688a"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["No. " + $F{letterNumber}]]></textFieldExpression>
