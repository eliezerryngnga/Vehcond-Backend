	<detail>
		<band height="250" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="10" width="50" height="20" uuid="3499797d-ff59-42e6-be77-d9c327b1be8e"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<text><![CDATA[Subject:]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="10" width="505" height="20" uuid="d7561ba0-4e1b-4192-a4e5-d544e5a348ba"/>
				<textElement>
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Disposal/Allotment of Government Condemned Vehicles.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="BodyText" x="0" y="45" width="555" height="45" positionType="Float" uuid="bf6b27cb-5658-480a-94c4-7f16e6f9a139"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["With reference to the subject cited above, a Government condemned vehicle <style isBold='true'>" + $F{registrationno} + "</style> belonging to " + $F{officename} + " is allotted to <style isBold='true'>" + $F{allotteesname} + "</style> for his/her personal use on the following conditions."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement style="BodyText" x="0" y="95" width="555" height="45" positionType="Float" uuid="27e774e8-7c60-4a10-be63-772ee6706771"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["1. The Vehicle will be released to him/her by the Department/Office concerned on payment of the amount of <style isBold='true'>₹ " + new java.text.DecimalFormat("#,##0").format($F{vcctcprice}) + "/-</style> being the Upset price of the vehicle fixed by the Vehicle Condemnation Committee minus 10% approved by Government."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="BodyText" x="0" y="145" width="555" height="20" positionType="Float" uuid="fd3d9d19-4468-4216-8557-7a0947563f24"/>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[2. The allottee should not sell the vehicle within a period of 2 (two) years from the date of purchase.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement style="BodyText" x="0" y="170" width="555" height="45" positionType="Float" uuid="5f9ed618-fa5b-4f9a-827b-a5926e8e4ffb"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["3. The Vehicle should be lifted within <style isBold='true'>1 (one) month</style> from the date of receipt of the allotment orders and if they fail to do so the allotment will stand automatically cancelled. No application for reduction of price or for extending the time of lifting will be entertained."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	
